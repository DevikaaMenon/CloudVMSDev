{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VmsBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR-VMS-BUCKET/*"
    },
    {
      "Sid": "VmsBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR-VMS-BUCKET"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents", "logs:CreateLogGroup"],
      "Resource": "arn:aws:logs:*:*:log-group:/cloud-vms/*"
    }
  ]
}
